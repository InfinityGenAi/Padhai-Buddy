# Firebase Client Config (required)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Emulator Configuration (for local development)
# Set to "true" to connect to Firebase emulators instead of production
# Requires: firebase emulators:start (Java 21+ required)
# NEXT_PUBLIC_USE_EMULATORS=false
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=localhost:8080

# AI Provider
GROQ_API_KEY=

# Firebase Admin SDK (required for server-side operations)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Admin Authentication
ADMIN_SECRET=

# Rate Limiting (optional)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=20

# Production Redis for Rate Limiting (optional - for multi-instance deployments)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=