{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Padhai Buddy",
  "version": "0.1.0",
  "identifier": "com.padhaibuddy.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Padhai Buddy",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 768,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon-16.png",
      "icons/icon-32.png",
      "icons/icon-48.png",
      "icons/icon-128.png",
      "icons/icon-256.png",
      "icons/icon-512.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": null,
      "msi": null,
      "appx": null
    }
  },
  "plugins": {
    "notification": {
      "enabled": true,
      "showOnForeground": true
    },
    "fs": {
      "enabled": false
    },
    "shell": {
      "enabled": true
    },
    "clipboard": {
      "enabled": true
    },
    "dialog": {
      "enabled": true
    }
  }
}