rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /admin/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid != null
        && request.auth.token.admin == true;
    }

    // usernameMappings is the authoritative username uniqueness index.
    // Clients may read it but MUST NOT create/update/delete it: all mutations go
    // through the server-side /api/username-claim API (Admin SDK bypasses rules).
    // This prevents clients from bypassing username uniqueness by writing mappings directly.
    match /usernameMappings/{username} {
      allow read: if request.auth != null && request.auth.uid != null;
      allow create, update, delete: if false;
    }

    match /dailyAnalytics/{docId} {
      allow read, write: if request.auth != null && request.auth.uid != null
        && request.auth.token.admin == true;
    }

    match /featureUsage/{userId} {
      allow read: if request.auth != null && request.auth.uid != null
        && request.auth.token.admin == true;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.uid is string
        && request.resource.data.uid == userId
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.class is int
        && request.resource.data.board in ["CBSE", "ICSE", "State Board"]
        && request.resource.data.createdAt is int
        && request.resource.data.preferences is map
        // The authoritative username field is owned by the server (/api/username-claim).
        // Clients must not set it at profile creation.
        && !("username" in request.resource.data);
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && !request.resource.data.keys().hasAny(['role', 'isAdmin', 'system'])
        && (!("name" in request.resource.data) || request.resource.data.name is string)
        && (!("email" in request.resource.data) || request.resource.data.email is string)
        && (!("class" in request.resource.data) || request.resource.data.class is int)
        && (!("board" in request.resource.data) || request.resource.data.board in ["CBSE", "ICSE", "State Board"])
        && (!("preferences" in request.resource.data) || request.resource.data.preferences is map)
        // The authoritative username field is owned by the server (/api/username-claim).
        // Clients must not change it directly; use /api/username-claim instead.
        && (!("username" in request.resource.data) || request.resource.data.username == resource.data.username);
      allow delete: if false;

      match /doubts/{doubtId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // Scored doubt records are created through authenticated server APIs.
        allow write: if false;
      }

      match /sessions/{sessionId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId
          && request.resource.data.keys().hasAll([
            'device', 'userAgent', 'lastActive', 'current', 'createdAt'
          ])
          && request.resource.data.device is string
          && request.resource.data.userAgent is string
          && request.resource.data.lastActive is number
          && request.resource.data.current is bool
          && request.resource.data.createdAt is number;
        allow update, delete: if request.auth != null && request.auth.uid == userId;
      }

      match /conversations/{conversationId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId
          && request.resource.data.title is string
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp;
        allow update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.title is string
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp;
        allow delete: if request.auth != null && request.auth.uid == userId;

        match /messages/{messageId} {
          allow read: if request.auth != null && request.auth.uid == userId;
          allow create: if request.auth != null && request.auth.uid == userId
            && request.resource.data.role in ["user", "assistant"]
            && request.resource.data.content is string
            && request.resource.data.createdAt is timestamp;
          allow update, delete: if request.auth != null && request.auth.uid == userId;
        }
      }

      match /studyPlans/{planId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // Completion and score fields are server-owned via /api/planner.
        allow write: if false;
      }

      match /quizAttempts/{attemptId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // Question keys, answer keys, scores and completion state are written
        // exclusively by /api/quiz using the Admin SDK.
        allow write: if false;
      }

      match /flashcardDecks/{deckId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // Deck and card writes must pass through /api/flashcards so score-credit
        // markers, rate limits and delete reversals are applied consistently.
        allow write: if false;

        match /cards/{cardId} {
          allow read: if request.auth != null && request.auth.uid == userId;
          allow write: if false;
        }
      }

      match /notes/{noteId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // Note creation/deletion affects the points ledger; use /api/notes.
        allow write: if false;
      }

      match /studySessions/{sessionId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // The timer API validates elapsed time and writes completedAt server-side.
        allow write: if false;
      }

      match /resources/{resourceId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId
          && request.resource.data.title is string
          && request.resource.data.subject is string
          && request.resource.data.type in ["video", "article", "pdf", "link", "notes"]
          && request.resource.data.description is string
          && request.resource.data.createdAt is number
          && request.resource.data.updatedAt is number;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /savedItems/{itemId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId
          && request.resource.data.content is string
          && request.resource.data.type in ["explanation", "question"]
          && request.resource.data.sourceMessageId is string
          && request.resource.data.conversationId is string
          && request.resource.data.createdAt is number;
        allow update, delete: if request.auth != null && request.auth.uid == userId;
      }

      match /notifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /topicMastery/{masteryId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId
          && request.resource.data.subject is string
          && request.resource.data.topic is string
          && request.resource.data.mastery is number
          && request.resource.data.totalQuestions is number
          && request.resource.data.correctAnswers is number
          && request.resource.data.lastPracticed is number
          && request.resource.data.updatedAt is number;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /mistakeBank/{entryId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId
          && request.resource.data.source in ["quiz", "flashcard", "chat"]
          && request.resource.data.sourceId is string
          && request.resource.data.subject is string
          && request.resource.data.topic is string
          && request.resource.data.question is string
          && request.resource.data.userAnswer is string
          && request.resource.data.correctAnswer is string
          && request.resource.data.explanation is string
          && request.resource.data.createdAt is number;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
